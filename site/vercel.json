{
  "rewrites": [
    { "source": "/", "destination": "/api/seo-home" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/:path*", "destination": "https://tayf-ai-three.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
